+    if (!stream || !stream->active) { errno = EBADF; return -1; }
+    return (int64_t)stream->position;
+}
+int64_t x64_memory_file_size(FILE *file)
+{
+    x64_memory_stream *stream = x64_memory_stream_find(file);
