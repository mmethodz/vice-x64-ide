+        case 63:
+            if (n) break;
+            result = x64_native_media_capture_reu(&id);
+            if (!result) result = x64_native_media_describe(id, bytes);
+            if (result) break;
+            x64_native_reply(op, request, 0, bytes, 28); return 1;
+    }
+    x64_native_reply(op, request, result ? result : -1, NULL, 0);
+    return 1;
+}
